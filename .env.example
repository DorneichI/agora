# Postgres (used by docker-compose.yml)
POSTGRES_USER=agora
POSTGRES_PASSWORD=agora
POSTGRES_DB=agora

# backend/ (async SQLAlchemy/asyncpg connection string)
DATABASE_URL=postgresql+asyncpg://agora:agora@postgres:5432/agora

# web/ (Clerk auth — see docs/architecture.md#auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ISSUER=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
